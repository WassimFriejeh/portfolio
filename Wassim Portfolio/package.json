{
  "name": "wassim-portfolio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "admin:create": "npm --prefix backend run admin:create",
    "test:e2e": "npm --prefix frontend exec -- playwright test",
    "test:api": "npm --prefix backend test"
  }
}
